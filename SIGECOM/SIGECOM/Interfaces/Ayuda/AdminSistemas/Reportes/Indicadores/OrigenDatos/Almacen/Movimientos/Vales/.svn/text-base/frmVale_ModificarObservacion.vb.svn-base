Imports System.Windows.Forms

Public Class frmVale_ModificarObservacion
    Public state_button As Boolean              'True: Modificar    False: nuevo
    Private oValeMaterialService As New ValeMaterialService.ValeMaterialServiceClient
    Public IdVale As Integer
    '====================================================================================================================
    '============================================ CONTROL'S METHOD ======================================================
    '====================================================================================================================
    Private Sub Initialize_Load(ByVal sender As System.Object, ByVal e As System.EventArgs) Handles MyBase.Load
        If oValeMaterialService.Estado(IdVale) <> Nothing And oValeMaterialService.Estado(IdVale) <> "GENERADO" Then
            btnGuardar.Enabled = False
        Else
            btnGuardar.Enabled = True
        End If
    End Sub
    Private Sub FinallyObjects_FormClosed(ByVal sender As Object, ByVal e As System.Windows.Forms.FormClosedEventArgs) Handles Me.FormClosed
        Try
            If isClosed(oValeMaterialService) = False Then
                oValeMaterialService.Close()
            End If
        Catch ex As Exception
            MsgBox("ERROR [FINALLY]: " + ex.Message, MsgBoxStyle.Exclamation)
        End Try
    End Sub
    '====================================================================================================================
    '============================================ INTERFACE'S METHOD ====================================================
    '====================================================================================================================
    Private Sub btnCancelar_Click(ByVal sender As System.Object, ByVal e As System.EventArgs) Handles btnCancelar.Click
        Me.DialogResult = Windows.Forms.DialogResult.Cancel
        Me.Close()
    End Sub
    Private Sub btnGuardar_Click(ByVal sender As System.Object, ByVal e As System.EventArgs) Handles btnGuardar.Click
        If state_button Then
            oValeMaterialService.ActualizarObservacion(IdVale, toNull(txtObservacion.Text), Session.sUsuario.cod_usuario)
        End If
        Me.DialogResult = Windows.Forms.DialogResult.OK
    End Sub
End Class
