Public Class Usuario
    Private pcod_usuario As String = "PRUEBA"
    Private pperfil As Perfil

    Public Property cod_usuario()
        Get
            Return pcod_usuario
        End Get
        Set(ByVal value)

        End Set
    End Property
    Public Property perfil() As Perfil
        Get
            Return pperfil
        End Get
        Set(ByVal value As Perfil)
            pperfil = value
        End Set
    End Property

End Class
