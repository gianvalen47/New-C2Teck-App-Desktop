Imports System.Windows.Forms

Public Class frmMarca

    Public state_button As Boolean              'True: Modificar    False: nuevo
    Public type_process As String               'update     insert      delete
    Private oMarcaService As New MarcaService.MarcaServiceClient
    Private dtDatos As DataTable
    Private state_Search As Boolean
    '====================================================================================================================
    '============================================ PARAMETROS LOCALES ====================================================
    '====================================================================================================================

    '====================================================================================================================
    '============================================ CONTROL'S METHOD ======================================================
    '====================================================================================================================
    Private Sub SendFocus_KeyPress(ByVal sender As Object, ByVal e As System.Windows.Forms.KeyPressEventArgs) Handles _
                           txtCodMar.KeyPress _
                          , txtAbrMar.KeyPress _
                          , txtDesMar.KeyPress _
                          , gbSubDatos1.KeyPress _
                          , cbPedMar.KeyPress _
                          , cbPreMar.KeyPress _
                          , cbIncPre.KeyPress
        If e.KeyChar = ChrW(Keys.Enter) Then
            e.Handled = True
            SendKeys.Send("{TAB}")
        End If
    End Sub
    Private Sub Initialize_Load(ByVal sender As System.Object, ByVal e As System.EventArgs) Handles MyBase.Load
        Me.CancelButton = Me.btnCancelar
        state_Search = False
        llenarCombos()
        If state_button Then    'Modificar
            Me.btnGuardar.Location = New System.Drawing.Point(176, 98)
            Me.btnEliminar.Location = New System.Drawing.Point(250, 98)
            txtCodMar.ReadOnly = True
            txtCodMar.TabStop = False
            ObtenerRegistro()
            Me.Text = "Marca " + Chr(34) + txtCodMar.Text.ToString + Chr(34)
        Else                    'Nuevo
            btnEliminar.Visible = False
            Me.btnEliminar.Location = New System.Drawing.Point(176, 98)
            Me.btnGuardar.Location = New System.Drawing.Point(250, 98)
            txtCodMar.ReadOnly = False
            txtCodMar.TabStop = True
            Me.Text = "Registrar nueva Marca"
        End If
        state_Search = True
    End Sub
    Private Sub FinallyObjects_FormClosed(ByVal sender As Object, ByVal e As System.Windows.Forms.FormClosedEventArgs) Handles Me.FormClosed
        If isClosed(oMarcaService) = False Then
            oMarcaService.Close()
        End If
    End Sub
    Private Sub setColor_BlankCajaTexto(ByVal sender As Object, ByVal e As System.Windows.Forms.KeyEventArgs) Handles _
                           txtCodMar.KeyUp _
                          , txtAbrMar.KeyUp _
                          , txtDesMar.KeyUp
        Try
            Dim campo As New Object
            If sender.GetType.ToString = "Janus.Windows.GridEX.EditControls.EditBox" Then
                campo = New Janus.Windows.GridEX.EditControls.EditBox
            ElseIf sender.GetType.ToString = "Janus.Windows.GridEX.EditControls.NumericEditBox" Then
                campo = New Janus.Windows.GridEX.EditControls.NumericEditBox
            ElseIf sender.GetType.ToString = "System.Windows.Forms.TextBox" Then
                campo = New TextBox
            End If
            campo = sender
            If campo.readonly = False Then
                If campo.Text.Trim.Length > 0 Then
                    campo.BackColor = Color.White
                Else
                    campo.BackColor = Color.Red
                End If
            End If
        Catch ex As Exception
            MsgBox(ex.Message)
        End Try
    End Sub
    Private Sub OnlyNumber_KeyPress(ByVal sender As Object, ByVal e As System.Windows.Forms.KeyPressEventArgs) Handles txtCodMar.KeyPress
        If Not Char.IsNumber(e.KeyChar) And (e.KeyChar = ChrW(Keys.Back)) = False And (e.KeyChar = ChrW(Keys.Enter)) = False Then
            e.KeyChar = Chr(0)
        End If
    End Sub
    '====================================================================================================================
    '============================================ TASK'S METHOD =========================================================
    '====================================================================================================================
    Private Function ValidaCampos() As Boolean
        Try
            Dim registro As New MarcaService.Marca
            registro.CodMar = toNull(txtCodMar.Text)
            If txtCodMar.Text.Trim = "" Then
                MsgBox("Debe Ingresar el código de la Marca", MsgBoxStyle.Information, "Información")
                txtCodMar.BackColor = Color.Red
                txtCodMar.Focus()
                Return False
            ElseIf txtAbrMar.Text = "" Then
                MsgBox("Debe Ingresar la Abreviatura de la Marca", MsgBoxStyle.Information, "Información")
                txtAbrMar.BackColor = Color.Red
                txtAbrMar.Focus()
                Return False
            ElseIf txtDesMar.Text = "" Then
                MsgBox("Debe Ingresar el descripción de la Marca", MsgBoxStyle.Information, "Información")
                txtDesMar.BackColor = Color.Red
                txtDesMar.Focus()
                Return False
            ElseIf state_button = False And oMarcaService.Buscar(registro) = True Then
                MsgBox("Código " + txtCodMar.Text + " ya existe...!", MsgBoxStyle.Information, "Información")
                txtCodMar.Text = ""
                txtCodMar.Focus()
                Return False
            Else
                Return True
            End If
        Catch ex As Exception
            MsgBox("ERROR [INFO-001]: " + ex.Message, MsgBoxStyle.Exclamation)
        End Try
    End Function
    Private Sub Insertar(ByVal registro As MarcaService.Marca)
        Try
            Dim estado_process As Boolean
            estado_process = oMarcaService.Insertar(registro)
            type_process = "insert"
            If estado_process = True Then
                Me.DialogResult = Windows.Forms.DialogResult.OK
            Else
                MsgBox("Error en el proceso, comuníquese con el departamento de sistemas...!", MsgBoxStyle.Critical)
            End If
        Catch ex As Exception
            MsgBox("ERROR [INFO-002]: " + ex.Message, MsgBoxStyle.Exclamation)
        End Try
    End Sub
    Private Sub Modificar(ByVal registro As MarcaService.Marca)
        Try
            Dim estado_process As Boolean
            estado_process = oMarcaService.Actualizar(registro)
            type_process = "update"
            If estado_process = True Then
                Me.DialogResult = Windows.Forms.DialogResult.OK
            Else
                MsgBox("Error en el proceso, comuníquese con el departamento de sistemas...!", MsgBoxStyle.Critical)
            End If
        Catch ex As Exception
            MsgBox("ERROR [INFO-003]: " + ex.Message, MsgBoxStyle.Exclamation)
        End Try
    End Sub
    Private Sub Eliminar(ByVal registro As MarcaService.Marca)
        Try
            Dim estado_process As Boolean
            estado_process = oMarcaService.Borrar(registro)
            type_process = "delete"
            If estado_process = True Then
                Me.DialogResult = Windows.Forms.DialogResult.OK
            Else
                MsgBox("Error en el proceso, comuníquese con el departamento de sistemas...!", MsgBoxStyle.Critical)
            End If
        Catch ex As Exception
            MsgBox("ERROR [INFO-004]: " + ex.Message, MsgBoxStyle.Exclamation)
        End Try
    End Sub
    Private Sub ObtenerRegistro()
        Try
            Dim registro As MarcaService.Marca
            registro = oMarcaService.MostrarPorCodigo(toNull(txtCodMar.Text))

            txtCodMar.Text = registro.CodMar
            txtDesMar.Text = registro.DesMar
            txtAbrMar.Text = registro.AbrMar
            cbPedMar.Checked = registro.PedMar
            cbPreMar.Checked = registro.PreMar
            cbIncPre.Checked = registro.IncPre

        Catch ex As Exception
            MsgBox("ERROR [INFO-005]: " + ex.Message, MsgBoxStyle.Exclamation)
        End Try
    End Sub
    Private Sub llenarCombos()
        Try

        Catch ex As Exception
            MsgBox("ERROR [INFO-006]: " + ex.Message, MsgBoxStyle.Exclamation)
        End Try
    End Sub
    '====================================================================================================================
    '============================================ INTERFACE'S METHOD ====================================================
    '====================================================================================================================
    Private Sub btnCancelar_Click(ByVal sender As System.Object, ByVal e As System.EventArgs) Handles btnCancelar.Click
        Me.DialogResult = Windows.Forms.DialogResult.Cancel
        Me.Close()
    End Sub
    Private Sub btnGuardar_Click(ByVal sender As System.Object, ByVal e As System.EventArgs) Handles btnGuardar.Click
        If MsgBox("¿Está seguro que desea guardar los datos?", MsgBoxStyle.YesNo, "Advertencia") = MsgBoxResult.Yes _
            And ValidaCampos() Then

            Dim registro As New MarcaService.Marca
            registro.CodMar = toNull(txtCodMar.Text)
            registro.DesMar = toNull(txtDesMar.Text)
            registro.AbrMar = toNull(txtAbrMar.Text)
            registro.PedMar = cbPedMar.Checked
            registro.PreMar = cbPreMar.Checked
            registro.IncPre = cbIncPre.Checked

            If state_button Then        'Modificar
                Modificar(registro)
            Else                        'Nuevo
                Insertar(registro)
            End If
        End If
    End Sub
    Private Sub btnEliminar_Click(ByVal sender As System.Object, ByVal e As System.EventArgs) Handles btnEliminar.Click
        If MsgBox("¿Está seguro que desea eliminar el registro?", MsgBoxStyle.YesNo, "Advertencia") = MsgBoxResult.Yes Then
            If txtCodMar.Text.Trim.Length > 0 Then
                Dim registro As New MarcaService.Marca
                registro.CodMar = txtCodMar.Text.Trim
                Eliminar(registro)
            Else
                MsgBox("Debe Ingresar el Código...!!!", MsgBoxStyle.Information, "Información")
                txtCodMar.Focus()
            End If
        End If
    End Sub

End Class
