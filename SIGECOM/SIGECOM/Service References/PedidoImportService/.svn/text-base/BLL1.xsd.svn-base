      <xs:element minOccurs="0" name="ObsCli" nillable="true" type="xs:string" />
      <xs:element minOccurs="0" name="RucCli" nillable="true" type="xs:string" />
      <xs:element minOccurs="0" name="SectorCliente" nillable="true" type="tns:SectorCliente" />
      <xs:element minOccurs="0" name="TelCli" nillable="true" type="xs:string" />
      <xs:element minOccurs="0" name="TipoCliente" nillable="true" type="tns:TipoCliente" />
      <xs:element minOccurs="0" name="TipoContribuyente" nillable="true" type="tns:TipoContribuyente" />
      <xs:element minOccurs="0" name="UrlCli" nillable="true" type="xs:string" />
    </xs:sequence>
  </xs:complexType>
  <xs:element name="Cliente" nillable="true" type="tns:Cliente" />
  <xs:complexType name="SectorCliente">
    <xs:sequence>
      <xs:element minOccurs="0" name="AbrSec" nillable="true" type="xs:string" />
      <xs:element minOccurs="0" name="CodSec" nillable="true" type="xs:string" />
      <xs:element minOccurs="0" name="DesSec" nillable="true" type="xs:string" />
    </xs:sequence>
  </xs:complexType>
