      <xs:element minOccurs="0" name="Oficina" nillable="true" type="tns:Oficina" />
      <xs:element minOccurs="0" name="pEmpresa" nillable="true" type="tns:Empresa" />
    </xs:sequence>
  </xs:complexType>
  <xs:element name="Locacion" nillable="true" type="tns:Locacion" />
  <xs:complexType name="Almacen">
