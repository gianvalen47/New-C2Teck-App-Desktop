      <xs:element minOccurs="0" name="FecFin" nillable="true" type="xs:dateTime" />
      <xs:element minOccurs="0" name="FecIni" nillable="true" type="xs:dateTime" />
      <xs:element minOccurs="0" name="FecPed" type="xs:dateTime" />
      <xs:element minOccurs="0" name="IdPedidoImp" nillable="true" type="xs:anyType" />
      <xs:element minOccurs="0" name="Locacion" nillable="true" type="tns:Locacion" />
      <xs:element minOccurs="0" name="NumPed" nillable="true" type="xs:string" />
      <xs:element minOccurs="0" name="ObsPed" nillable="true" type="xs:string" />
      <xs:element minOccurs="0" name="TotPed" type="xs:double" />
    </xs:sequence>
  </xs:complexType>
  <xs:element name="PedidoImport" nillable="true" type="tns:PedidoImport" />
  <xs:complexType name="Cliente">
    <xs:sequence>
