      <xs:element minOccurs="0" name="AbrTipo" nillable="true" type="xs:string" />
      <xs:element minOccurs="0" name="DesTipoCli" nillable="true" type="xs:string" />
      <xs:element minOccurs="0" name="IdTipoCliente" type="xs:int" />
    </xs:sequence>
  </xs:complexType>
  <xs:element name="TipoCliente" nillable="true" type="tns:TipoCliente" />
  <xs:complexType name="TipoContribuyente">
