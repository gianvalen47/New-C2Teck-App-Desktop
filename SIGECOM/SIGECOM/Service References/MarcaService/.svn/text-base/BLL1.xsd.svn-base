<?xml version="1.0" encoding="utf-8"?>
<xs:schema xmlns:tns="http://schemas.datacontract.org/2004/07/BLL" elementFormDefault="qualified" targetNamespace="http://schemas.datacontract.org/2004/07/BLL" xmlns:xs="http://www.w3.org/2001/XMLSchema">
  <xs:complexType name="Marca">
    <xs:sequence>
      <xs:element minOccurs="0" name="AbrMar" nillable="true" type="xs:string" />
      <xs:element minOccurs="0" name="CodMar" nillable="true" type="xs:string" />
      <xs:element minOccurs="0" name="DesMar" nillable="true" type="xs:string" />
      <xs:element minOccurs="0" name="IncPre" type="xs:boolean" />
      <xs:element minOccurs="0" name="PedMar" type="xs:boolean" />
      <xs:element minOccurs="0" name="PreMar" type="xs:boolean" />
    </xs:sequence>
  </xs:complexType>
  <xs:element name="Marca" nillable="true" type="tns:Marca" />
</xs:schema>