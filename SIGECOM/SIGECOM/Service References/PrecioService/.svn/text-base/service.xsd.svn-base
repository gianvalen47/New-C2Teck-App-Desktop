<?xml version="1.0" encoding="utf-8"?>
<xs:schema xmlns:tns="http://tempuri.org/" elementFormDefault="qualified" targetNamespace="http://tempuri.org/" xmlns:xs="http://www.w3.org/2001/XMLSchema">
  <xs:element name="PrecioMostrador">
    <xs:complexType>
      <xs:sequence>
        <xs:element minOccurs="0" name="pIdLocacion" type="xs:int" />
        <xs:element minOccurs="0" name="pCodMer" nillable="true" type="xs:string" />
        <xs:element minOccurs="0" name="pCodMon" nillable="true" type="xs:string" />
      </xs:sequence>
    </xs:complexType>
  </xs:element>
  <xs:element name="PrecioMostradorResponse">
    <xs:complexType>
      <xs:sequence>
        <xs:element minOccurs="0" name="PrecioMostradorResult" type="xs:double" />
      </xs:sequence>
    </xs:complexType>
  </xs:element>
  <xs:element name="PrecioSPCC">
    <xs:complexType>
      <xs:sequence>
        <xs:element minOccurs="0" name="pCodMer" nillable="true" type="xs:string" />
      </xs:sequence>
    </xs:complexType>
  </xs:element>
  <xs:element name="PrecioSPCCResponse">
    <xs:complexType>
      <xs:sequence>
        <xs:element minOccurs="0" name="PrecioSPCCResult" type="xs:double" />
      </xs:sequence>
    </xs:complexType>
  </xs:element>
  <xs:element name="PrecioOferta">
    <xs:complexType>
      <xs:sequence>
        <xs:element minOccurs="0" name="pIdLocacion" type="xs:int" />
        <xs:element minOccurs="0" name="pCodMer" nillable="true" type="xs:string" />
      </xs:sequence>
    </xs:complexType>
  </xs:element>
  <xs:element name="PrecioOfertaResponse">
    <xs:complexType>
      <xs:sequence>
        <xs:element minOccurs="0" name="PrecioOfertaResult" type="xs:double" />
      </xs:sequence>
    </xs:complexType>
  </xs:element>
  <xs:element name="PrecioFabrica">
    <xs:complexType>
      <xs:sequence>
        <xs:element minOccurs="0" name="pCodMer" nillable="true" type="xs:string" />
        <xs:element minOccurs="0" name="pCodMon" nillable="true" type="xs:string" />
        <xs:element minOccurs="0" name="Fecha" type="xs:dateTime" />
      </xs:sequence>
    </xs:complexType>
  </xs:element>
  <xs:element name="PrecioFabricaResponse">
    <xs:complexType>
      <xs:sequence>
        <xs:element minOccurs="0" name="PrecioFabricaResult" type="xs:double" />
      </xs:sequence>
    </xs:complexType>
  </xs:element>
  <xs:element name="PrecioVenta">
    <xs:complexType>
      <xs:sequence>
        <xs:element minOccurs="0" name="pIdLocacion" type="xs:int" />
        <xs:element minOccurs="0" name="pIdCliente" type="xs:int" />
        <xs:element minOccurs="0" name="pCodMer" nillable="true" type="xs:string" />
        <xs:element minOccurs="0" name="pCodMon" nillable="true" type="xs:string" />
        <xs:element minOccurs="0" name="pFecha" type="xs:dateTime" />
      </xs:sequence>
    </xs:complexType>
  </xs:element>
  <xs:element name="PrecioVentaResponse">
    <xs:complexType>
      <xs:sequence>
        <xs:element minOccurs="0" name="PrecioVentaResult" type="xs:double" />
      </xs:sequence>
    </xs:complexType>
  </xs:element>
  <xs:element name="FactorCliente">
    <xs:complexType>
      <xs:sequence>
        <xs:element minOccurs="0" name="pIdLocacion" type="xs:int" />
        <xs:element minOccurs="0" name="pIdCliente" type="xs:int" />
      </xs:sequence>
    </xs:complexType>
  </xs:element>
  <xs:element name="FactorClienteResponse">
    <xs:complexType>
      <xs:sequence>
        <xs:element minOccurs="0" name="FactorClienteResult" type="xs:double" />
      </xs:sequence>
    </xs:complexType>
  </xs:element>
  <xs:element name="DescuentoCliente">
    <xs:complexType>
      <xs:sequence>
        <xs:element minOccurs="0" name="pIdLocacion" type="xs:int" />
        <xs:element minOccurs="0" name="pIdCliente" type="xs:int" />
      </xs:sequence>
    </xs:complexType>
  </xs:element>
  <xs:element name="DescuentoClienteResponse">
    <xs:complexType>
      <xs:sequence>
        <xs:element minOccurs="0" name="DescuentoClienteResult" type="xs:double" />
      </xs:sequence>
    </xs:complexType>
  </xs:element>
  <xs:element name="MostrarStock">
    <xs:complexType>
      <xs:sequence>
        <xs:element minOccurs="0" name="pIdLocacion" type="xs:int" />
        <xs:element minOccurs="0" name="pCodMer" nillable="true" type="xs:string" />
