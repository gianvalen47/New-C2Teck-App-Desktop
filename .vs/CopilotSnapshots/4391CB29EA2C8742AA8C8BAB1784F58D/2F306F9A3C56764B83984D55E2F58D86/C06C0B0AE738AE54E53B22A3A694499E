"""
API routers for Caja Chica (petty cash) and Gastos (expenses)

Consumes from legacy SIGECOM adapter when enabled, otherwise uses local SQLite.
"""
import logging
import uuid
from datetime import datetime

from fastapi import APIRouter, Depends, HTTPException, status
from sqlalchemy.orm import Session

from config import SessionLocal
from models import CajaChicaModel, GastoModel
from schemas import (
    CajaChicaCreate,
    CajaChicaRead,
    CajaChicaUpdate,
    GastoCreate,
    GastoRead,
    GastoUpdate,
)
from legacy_adapter import (
    is_legacy_source_enabled,
    list_caja_chica_legacy,
    get_caja_chica_legacy,
)

logger = logging.getLogger(__name__)

router = APIRouter(prefix="/caja-chica", tags=["Caja Chica"])


def get_db():
    db = SessionLocal()
    try:
        yield db
    finally:
        db.close()


# ============================================================================
# CAJA CHICA ENDPOINTS
# ============================================================================

@router.get("", response_model=list[CajaChicaRead])
def list_caja_chica(skip: int = 0, limit: int = 100, db: Session = Depends(get_db)):
    """List all petty cash accounts (from legacy adapter if enabled)"""
    if is_legacy_source_enabled():
        try:
            data = list_caja_chica_legacy(skip=skip, limit=limit)
            if isinstance(data, dict) and "items" in data:
                return data["items"]
            elif isinstance(data, list):
                return data
            else:
                return [data] if data else []
        except Exception as exc:
            logger.error(f"Failed to fetch caja chica from legacy adapter: {exc}")
            raise HTTPException(
                status_code=status.HTTP_503_SERVICE_UNAVAILABLE,
                detail=f"SIGECOM legacy adapter unavailable: {type(exc).__name__}. "
                       f"Start sigecoom-wcf-adapter.exe or check SIGECOM_LEGACY_ADAPTER_BASE_URL.",
            )

    # Fallback to local SQLite
    cajas = db.query(CajaChicaModel).offset(skip).limit(limit).all()
    return cajas


@router.get("/{caja_id}", response_model=CajaChicaRead)
def get_caja_chica(caja_id: str, db: Session = Depends(get_db)):
    """Get a specific petty cash account (from legacy adapter if enabled)"""
    if is_legacy_source_enabled():
        try:
            return get_caja_chica_legacy(caja_id)
        except Exception as exc:
            logger.error(f"Failed to fetch caja chica {caja_id} from legacy adapter: {exc}")
            raise HTTPException(
                status_code=status.HTTP_503_SERVICE_UNAVAILABLE,
                detail=f"SIGECOM legacy adapter unavailable: {type(exc).__name__}. "
                       f"Start sigecoom-wcf-adapter.exe or check SIGECOM_LEGACY_ADAPTER_BASE_URL.",
            )

    # Fallback to local SQLite
    caja = db.query(CajaChicaModel).filter(CajaChicaModel.id == caja_id).first()
    if not caja:
        raise HTTPException(status_code=status.HTTP_404_NOT_FOUND, detail=f"Caja Chica {caja_id} not found")
    return caja


@router.post("", response_model=CajaChicaRead)
def create_caja_chica(caja: CajaChicaCreate, db: Session = Depends(get_db)):
    """Create a new petty cash account."""
    db_caja = CajaChicaModel(
        id=str(uuid.uuid4()),
        name=caja.name,
        responsible=caja.responsible,
        assigned_fund=caja.assigned_fund,
        currency=caja.currency,
        location=caja.location,
        status="active",
    )
    db.add(db_caja)
    db.commit()
    db.refresh(db_caja)
    return db_caja


@router.put("/{caja_id}", response_model=CajaChicaRead)
def update_caja_chica(caja_id: str, caja: CajaChicaUpdate, db: Session = Depends(get_db)):
    """Update a petty cash account."""
    db_caja = db.query(CajaChicaModel).filter(CajaChicaModel.id == caja_id).first()
    if not db_caja:
        raise HTTPException(status_code=status.HTTP_404_NOT_FOUND, detail=f"Caja Chica {caja_id} not found")

    update_data = caja.dict(exclude_unset=True)
    for key, value in update_data.items():
        setattr(db_caja, key, value)

    db.add(db_caja)
    db.commit()
    db.refresh(db_caja)
    return db_caja


# ============================================================================
# GASTO ENDPOINTS
# ============================================================================

@router.get("/{caja_id}/gastos", response_model=list[GastoRead])
def list_gastos(
    caja_id: str,
    status_filter: str | None = None,
    skip: int = 0,
    limit: int = 100,
    db: Session = Depends(get_db),
):
    """List expenses for a petty cash account."""
    query = db.query(GastoModel).filter(GastoModel.caja_chica_id == caja_id)
    if status_filter:
        query = query.filter(GastoModel.status == status_filter)
    gastos = query.order_by(GastoModel.date.desc()).offset(skip).limit(limit).all()
    return gastos


@router.get("/gastos/{gasto_id}", response_model=GastoRead)
def get_gasto(gasto_id: str, db: Session = Depends(get_db)):
    """Get a specific expense."""
    gasto = db.query(GastoModel).filter(GastoModel.id == gasto_id).first()
    if not gasto:
        raise HTTPException(status_code=status.HTTP_404_NOT_FOUND, detail=f"Gasto {gasto_id} not found")
    return gasto


@router.post("/{caja_id}/gastos", response_model=GastoRead)
def create_gasto(caja_id: str, gasto: GastoCreate, db: Session = Depends(get_db)):
    """Create a new expense for a petty cash account."""
    # Verify caja exists
    caja = db.query(CajaChicaModel).filter(CajaChicaModel.id == caja_id).first()
    if not caja:
        raise HTTPException(status_code=status.HTTP_404_NOT_FOUND, detail=f"Caja Chica {caja_id} not found")

    db_gasto = GastoModel(
        id=str(uuid.uuid4()),
        caja_chica_id=caja_id,
        date=gasto.date or datetime.now(),
        concept=gasto.concept,
        voucher_type=gasto.voucher_type,
        voucher_number=gasto.voucher_number,
        amount=gasto.amount,
        category=gasto.category,
        description=gasto.description,
        status="pending",
    )
    db.add(db_gasto)
    db.commit()
    db.refresh(db_gasto)
    return db_gasto


@router.put("/gastos/{gasto_id}", response_model=GastoRead)
def update_gasto(gasto_id: str, gasto: GastoUpdate, db: Session = Depends(get_db)):
    """Update an expense."""
    db_gasto = db.query(GastoModel).filter(GastoModel.id == gasto_id).first()
    if not db_gasto:
        raise HTTPException(status_code=status.HTTP_404_NOT_FOUND, detail=f"Gasto {gasto_id} not found")

    update_data = gasto.dict(exclude_unset=True)
    for key, value in update_data.items():
        setattr(db_gasto, key, value)

    db.add(db_gasto)
    db.commit()
    db.refresh(db_gasto)
    return db_gasto


@router.delete("/gastos/{gasto_id}", status_code=status.HTTP_204_NO_CONTENT)
def delete_gasto(gasto_id: str, db: Session = Depends(get_db)):
    """Delete an expense (soft delete via status)."""
    db_gasto = db.query(GastoModel).filter(GastoModel.id == gasto_id).first()
    if not db_gasto:
        raise HTTPException(status_code=status.HTTP_404_NOT_FOUND, detail=f"Gasto {gasto_id} not found")

    db_gasto.status = "archived"
    db.add(db_gasto)
    db.commit()


@router.post("/{caja_id}/submit")
def submit_gastos(caja_id: str, gasto_ids: list[str], db: Session = Depends(get_db)):
    """Submit expenses for reimbursement."""
    gastos = db.query(GastoModel).filter(GastoModel.id.in_(gasto_ids)).all()
    if not gastos:
        raise HTTPException(status_code=status.HTTP_404_NOT_FOUND, detail="No expenses found")

    for gasto in gastos:
        gasto.status = "submitted"
        gasto.submitted_date = datetime.now()
        db.add(gasto)

    db.commit()
    return {"message": f"{len(gastos)} gastos submitted"}


@router.post("/{caja_id}/reimburse")
def reimburse_gastos(caja_id: str, gasto_ids: list[str], db: Session = Depends(get_db)):
    """Mark expenses as reimbursed."""
    gastos = db.query(GastoModel).filter(GastoModel.id.in_(gasto_ids)).all()
    if not gastos:
        raise HTTPException(status_code=status.HTTP_404_NOT_FOUND, detail="No expenses found")

    for gasto in gastos:
        gasto.status = "reimbursed"
        gasto.reimbursed_date = datetime.now()
        db.add(gasto)

    db.commit()
    return {"message": f"{len(gastos)} gastos reimbursed"}


@router.get("/{caja_id}/balance")
def get_caja_balance(caja_id: str, db: Session = Depends(get_db)):
    """Calculate balance for petty cash account."""
    caja = db.query(CajaChicaModel).filter(CajaChicaModel.id == caja_id).first()
    if not caja:
        raise HTTPException(status_code=status.HTTP_404_NOT_FOUND, detail=f"Caja Chica {caja_id} not found")

    # Sum pending gastos
    pending = db.query(GastoModel).filter(
        GastoModel.caja_chica_id == caja_id,
        GastoModel.status.in_(["pending", "submitted"]),
    ).all()
    total_pending = sum(g.amount for g in pending)

    # Sum reimbursed gastos
    reimbursed = db.query(GastoModel).filter(
        GastoModel.caja_chica_id == caja_id,
        GastoModel.status == "reimbursed",
    ).all()
    total_reimbursed = sum(g.amount for g in reimbursed)

    return {
        "caja_id": caja_id,
        "assigned_fund": caja.assigned_fund,
        "total_gastos_pending": total_pending,
        "total_gastos_reimbursed": total_reimbursed,
        "saldo_actual": caja.assigned_fund - total_pending,
        "reembolso_a_solicitar": total_pending,
    }
